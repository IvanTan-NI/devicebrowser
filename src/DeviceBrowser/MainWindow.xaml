<Window x:Class="DeviceBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Browser"
        Width="900"
        Height="520"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F6F8">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="20"
                Background="White"
                BorderBrush="#FFD9DEE5"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Text="Devices" />

                <ListBox x:Name="DeviceList"
                         Grid.Row="1"
                         Margin="0,18,0,0"
                         Padding="4"
                         AutomationProperties.AutomationId="DeviceList"
                         BorderBrush="#FFD9DEE5"
                         DisplayMemberPath="Name"
                         SelectionChanged="DeviceList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name"
                                    Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Padding="24"
                Background="White"
                BorderBrush="#FFD9DEE5"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Text="Device Details" />

                <Grid Grid.Row="1" Margin="0,24,0,16">
                    <TextBlock x:Name="InitialInstructionText"
                               AutomationProperties.AutomationId="InitialInstructionText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#FF59636E"
                               Text="Select a device to view its details."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Grid x:Name="DetailsPanel"
                          AutomationProperties.AutomationId="DetailsPanel"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,12,14"
                                   FontWeight="SemiBold"
                                   Text="Name" />
                        <TextBlock x:Name="DeviceNameText"
                                   Grid.Column="1"
                                   Margin="0,0,0,14"
                                   AutomationProperties.AutomationId="DeviceNameText" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,0,12,14"
                                   FontWeight="SemiBold"
                                   Text="Model" />
                        <TextBlock x:Name="DeviceModelText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,0,0,14"
                                   AutomationProperties.AutomationId="DeviceModelText" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,0,12,14"
                                   FontWeight="SemiBold"
                                   Text="Serial number" />
                        <TextBlock x:Name="DeviceSerialNumberText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,0,0,14"
                                   AutomationProperties.AutomationId="DeviceSerialNumberText" />

                        <TextBlock Grid.Row="3"
                                   Margin="0,0,12,14"
                                   FontWeight="SemiBold"
                                   Text="Status" />
                        <TextBlock x:Name="DeviceStatusText"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="0,0,0,14"
                                   AutomationProperties.AutomationId="DeviceStatusText" />

                        <TextBlock Grid.Row="4"
                                   Margin="0,0,12,0"
                                   FontWeight="SemiBold"
                                   Text="Address" />
                        <TextBlock x:Name="DeviceAddressText"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   AutomationProperties.AutomationId="DeviceAddressText" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="2">
                    <StackPanel x:Name="LoadingPanel"
                                AutomationProperties.AutomationId="LoadingPanel"
                                Orientation="Horizontal"
                                Visibility="Collapsed">
                        <ProgressBar Width="120"
                                     Height="6"
                                     Margin="0,0,12,0"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#FF3A526A"
                                   Text="Loading device details..." />
                    </StackPanel>

                    <Border x:Name="ErrorBorder"
                            Padding="12"
                            AutomationProperties.AutomationId="ErrorBorder"
                            Background="#FFFFEEEE"
                            BorderBrush="#FFD14343"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText"
                                   AutomationProperties.AutomationId="ErrorText"
                                   Foreground="#FF9D2424"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

